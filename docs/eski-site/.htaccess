# iona-tr.com -> ionaengineering.com kalıcı (301) yönlendirme.
# Güzel Hosting cPanel > Dosya Yöneticisi > public_html/.htaccess dosyasının
# YERİNE konur. E-posta (hello@ / info@iona-tr.com) etkilenmez: posta MX/DNS
# kayıtlarından çalışır, bu dosya yalnızca web isteklerini yönlendirir.
# Eski site İngilizceydi; sayfalar yeni sitenin /en/ karşılıklarına gider ki
# Google sıralamayı doğru sayfaya devretsin.

RewriteEngine On

# Hizmet sayfaları -> her biri kendi yeni sayfasına (İngilizce sürüm)
RewriteRule ^(iona-)?biogas-plant-design/?$ https://ionaengineering.com/en/hizmetler/biyogaz-tesisi-tasarimi.html [R=301,L,NC]
RewriteRule ^(iona-)?epc-services/?$ https://ionaengineering.com/en/hizmetler/anahtar-teslim-epc.html [R=301,L,NC]
RewriteRule ^(iona-)?biogas-plant-optimization-re-engineering-services/?$ https://ionaengineering.com/en/hizmetler/tesis-optimizasyonu.html [R=301,L,NC]
RewriteRule ^(iona-)?gas-purification-units/?$ https://ionaengineering.com/en/hizmetler/gaz-aritma-biyometan.html [R=301,L,NC]
RewriteRule ^(iona-)?digestate-removement-enrichment/?$ https://ionaengineering.com/en/hizmetler/digestat-ayirma.html [R=301,L,NC]
RewriteRule ^(iona-)?drying-units/?$ https://ionaengineering.com/en/hizmetler/kurutma-uniteleri.html [R=301,L,NC]
RewriteRule ^(iona-)?odor-removal-units/?$ https://ionaengineering.com/en/hizmetler/koku-giderme.html [R=301,L,NC]
RewriteRule ^(iona-)?substrate-preparation-for-hemicellulose-lignin-rich-feedstocks/?$ https://ionaengineering.com/en/hizmetler/substrat-hazirlama.html [R=301,L,NC]
RewriteRule ^(iona-)?micro-orc-systems/?$ https://ionaengineering.com/en/hizmetler/mikro-orc.html [R=301,L,NC]
RewriteRule ^(iona-)?technical-consulting/?$ https://ionaengineering.com/en/hizmetler/teknik-danismanlik.html [R=301,L,NC]


# Kurumsal
RewriteRule ^about-iona/?$ https://ionaengineering.com/en/hakkimizda.html [R=301,L,NC]
RewriteRule ^(contact|get-quote)/?$ https://ionaengineering.com/en/iletisim.html [R=301,L,NC]
RewriteRule ^galeri/?$ https://ionaengineering.com/duyurular.html [R=301,L,NC]

# Geri kalan her şey (ana sayfa dahil) -> yeni ana sayfa
RewriteRule ^ https://ionaengineering.com/ [R=301,L]
