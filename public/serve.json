{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/teknoloji", "destination": "/teknoloji.html" },
    { "source": "/hakkimizda", "destination": "/hakkimizda.html" },
    { "source": "/etki", "destination": "/etki.html" },
    { "source": "/iletisim", "destination": "/iletisim.html" },
    { "source": "/ionaflux", "destination": "/ionaflux.html" },
    { "source": "/duyurular", "destination": "/duyurular.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/:lang(en|de|es|fr|ru|hi)", "destination": "/:lang/index.html" },
    { "source": "/:lang(en|de|es|fr|ru|hi)/:page(teknoloji|hakkimizda|etki|iletisim|ionaflux|duyurular)", "destination": "/:lang/:page.html" }
  ],
  "headers": [
    {
      "source": "assets/**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "**/*.@(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm|woff|woff2|ttf|otf|glb|hdr|exr|bin|wasm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "**/*.@(xml|txt|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
