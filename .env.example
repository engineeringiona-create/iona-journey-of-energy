# .env.example — bu dosyayı `.env` olarak kopyalayıp doldurun.
# .env git'e girmez (.gitignore), .env.example girer.

# ─── Supabase (admin paneli, içerik, formlar) ────────────────────────────────
# Boş bırakılırsa getSupabase() null döner ve site içeriği hardcoded/localStorage
# üzerinden çalışmaya devam eder — ama admin panelindeki kayıtlar cihazlar
# arasında senkronlanmaz (bkz. LESSONS.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── 3D modelin servis edildiği yer ──────────────────────────────────────────
# TANIMLIYSA: ana sayfadaki tesis modeli (iona-tesis-3d.draco.glb, ~0,7 MB)
# Supabase Storage'ın CDN'inden yüklenir, sitenin kendi origin'inden değil.
# TANIMSIZSA: eskisi gibi public/models/ altından yüklenir. İkisi de çalışır;
# uzak kopya açılmazsa site zaten otomatik olarak yerel kopyaya düşer.
#
# Yükleme:  npm run model:upload      (aşağıdaki service_role anahtarı gerekir)
VITE_MODEL_BUCKET=

# Supabase dışında bir CDN/özel domain kullanılacaksa base URL'i buraya yazın;
# VITE_MODEL_BUCKET'ı ezer. Sonunda / olmasın.
# Örn: https://cdn.ornek.com/models
VITE_MODEL_BUCKET_URL=

# ─── Sadece yerel/CI scriptleri için — TARAYICIYA GİTMEZ ─────────────────────
# service_role anahtarı RLS'i tamamen atlar. Asla VITE_ önekiyle tanımlamayın,
# asla istemci koduna koymayın. Yalnızca scripts/upload-model.mjs kullanır.
SUPABASE_SERVICE_ROLE_KEY=
# Opsiyonel: upload scriptinin yazacağı bucket adı (varsayılan "models").
MODEL_BUCKET=models
