{
  "name": "iona-journey-of-energy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-i18n-pages.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "start": "serve dist -l $PORT --no-clipboard",
    "model:bake": "node scripts/model-lab/bake-plant.mjs",
    "model:draco": "npx -y @gltf-transform/cli@4 draco model-lab/out/iona-tesis-baked.glb public/models/iona-tesis-3d.draco.glb --method edgebreaker --quantize-position 14 --quantize-normal 10 --quantize-texcoord 12",
    "model:build": "npm run model:bake && npm run model:draco",
    "model:upload": "node scripts/upload-model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve": "^14.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "node-html-parser": "^9.0.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
